// Topology
topology = mesh;
k = 3;
n = 2;
// Routing
routing_function = dor;
// Flow control
num_vcs = 1;  
vc_buf_size = 16;
vc_allocator = separable_input_first;  
sw_allocator = separable_input_first;  
arb_type = round_robin;  
speculative = 0;  
// Traffic
traffic = uniform;  
packet_size = 4;  
injection_rate = 0.12; // 4 Flits per Packet = 0.48 Flits per Cycle
// Simulation
sim_type = latency;  
sample_period = 10000;  
max_samples = 10;  
warmup_periods = 3;  
