//A single cross 10X10 cross bar under injection mode

topology = anynet;

// Router pipeline for 3 Cycles
routing_delay = 0;
vc_alloc_delay = 1;
sw_alloc_delay = 1;
st_prepare_delay = 0;
st_final_delay = 1;  
credit_delay = 0;
// Flow control
num_vcs = 8;
vc_buf_size = 8;
// Allocators  
vc_allocator = separable_input_first; 
sw_allocator = separable_input_first;
alloc_iters  = 1;

routing_function = min;
network_file = examples/ReplicatePaperZeroLoad/anynet_file;
traffic = uniform;
packet_size = 1;  
injection_rate = 0.001;

// Simulation
sim_type = latency;  
sample_period = 10000;  
max_samples = 10;  
warmup_periods = 3;  

END Configuration File: examples/ReplicatePaperZeroLoad/anynet_config
